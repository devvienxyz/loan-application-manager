{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"composite": true,
		"declaration": true,
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"module": "ESNext",
		"target": "ESNext",
		"resolveJsonModule": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src"]
}
