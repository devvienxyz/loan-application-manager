{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM"],
		"types": ["vitest/globals", "@testing-library/jest-dom"],
		"baseUrl": "./",
		"paths": {
      "@/*": ["src/*"],
			"@loan-app-mgr/shared/*": ["../shared/src/*"]
